{
  "version": 2,
  "name": "uwillschedule",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 2048
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?path=/api/$1"
    },
    {
      "source": "/output/(.*)",
      "destination": "/api/index?path=/output/$1"
    }
  ]
}
